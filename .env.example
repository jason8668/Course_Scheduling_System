# 复制此档为 .env,至少修改「管理员密码」与「校名」两项即可启动。
#   cp .env.example .env

# ── 必改 ─────────────────────────────
# 系统管理员默认帐密(首次登录后会强制改密码)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# 学校名称(显示于介面与导出课表)。这只是「初始值」——系统启用后可于
# 「系统管理 → 学校信息」随时修改,不需要回来改这里再重启。
SCHOOL_NAME=示范学校
# 学校所在时区(用于「今日课表」「当日调代课」等判定)
TZ=Asia/Taipei
# session cookie 签章金钥(正式部署务必改成随机长字串,例如 openssl rand -hex 32 的输出)
SECRET_KEY=please-change-this-to-a-random-secret

# ── 网路 ─────────────────────────────
# 对外连接埠(默认 80;若被占用可改 8080 等)
HTTP_PORT=80

# ── 选配:网域与 HTTPS(校外连线时使用,见 docs/deploy/https.md)──
# 内网 IP 使用维持默认(不设 SITE_ADDRESS,走 HTTP)即可。
# 若有公开网域并要自动申请 HTTPS 凭证,设为你的网域名(需先把网域 A 记录指向本主机):
# SITE_ADDRESS=school.example.edu.tw
# HTTPS_PORT=443
# 设了上面的网域(走 HTTPS)后,系统会自动为登录 cookie 加上 Secure 旗标;
# 一般不必手动设置。若需强制指定可用下行(true=仅 HTTPS 传送 cookie):
# COOKIE_SECURE=true

# ── 预建映像版本(仅「拉取映像」部署方式需要)──────────
# 用 docker compose pull 拉官方映像时,决定要拉哪一版。
# 默认 latest(最新);正式部署建议钉选版本号以利可控升级,例如:
# IMAGE_TAG=v1.3.0
# 若你是从原始码 docker compose up -d 自行建置,此项可忽略。
IMAGE_TAG=latest

# ── 新版本提醒(v1.2.3 起)──────────────────────────
# 系统管理员会在「系统管理」看到是否有新版本。每天最多向 GitHub 读取一次公开的版本信息,
# 不送出任何学校资料;不希望主机连外时取消下行注解。
# UPDATE_CHECK_ENABLED=false

# ── 资料库(单机部署维持默认即可;若改帐密需三者一致)──
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler
POSTGRES_DB=scheduler
DATABASE_URL=postgresql+psycopg://scheduler:scheduler@postgres:5432/scheduler

# ── 伫列 ─────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── 选填:互动式 API 文件 ──────────────
# 默认关闭。端点本身都有权限守著,公开它不是漏洞,但会把整套内部 API 摊在网路上;
# 若要自行串接系统 API,可暂时打开 http://<主机>/api/docs 查阅后再关掉。
# API_DOCS_ENABLED=true

# ── 选填:寄信(未设置则仅站内通知,见 M4-3)──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
