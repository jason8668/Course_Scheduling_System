# 正式部署反向代理设置。
# 站台位址由环境变数 SITE_ADDRESS 决定(于 .env 设置,由 web 容器带入):
#   未设置(默认):`:80` — 内网 IP 走 HTTP。
#   设为网域名(例 school.example.edu.tw):Caddy 自动申请并续期 HTTPS 凭证。
{
	admin off
}

{$SITE_ADDRESS::80} {
	# 请求体上限,防止(内部误操作或被盗帐号的)超大上传打爆单校主机记忆体。
	# 200MB 容得下真实资料库还原的 .dump 与 Excel 导入;超大资料库还原改用 volume 复制法
	# (见 docs/deploy/backup.md),不走网页上传。
	request_body {
		max_size 200MB
	}

	# API 交给后端
	handle /api/* {
		reverse_proxy api:8000
	}

	# 其余走前端 SPA,找不到档案回退 index.html(支援 vue-router history 模式)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	encode gzip
}
